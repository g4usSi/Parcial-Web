                  "    pm.expect(Number.isNaN(Date.parse(tarea.fechaEntrega))).to.eql(false);",
                  "    pm.expect([\"pendiente\", \"completada\"]).to.include(tarea.estado);",
                  "}",
                  "pm.test(\"Solo pendientes\", function () { const tareas = pm.response.json(); pm.expect(tareas).to.be.an(\"array\"); tareas.forEach(t => { validarTarea(t); pm.expect(t.estado).to.eql(\"pendiente\"); }); });"
                ]
