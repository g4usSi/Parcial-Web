{
  "info": {
    "name": "Serie III - Campus Virtual - API de tareas",
    "description": "Django + SQLite. Ejecutar el servidor y cargar_demo. Variables incluidas; no requiere environment ni autenticación. La operación PATCH modifica los datos de demostración. Los errores de la segunda carpeta son resultados esperados.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "tarea_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Operaciones solicitadas",
      "item": [
        {
          "name": "01 - Consultar todas las tareas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/tareas/",
            "description": "Devuelve todas las tareas y selecciona una existente para las solicitudes posteriores. Ejecutar cargar_demo antes de usar el runner."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"La respuesta es JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "function validarTarea(tarea) {",
                  "    pm.expect(tarea).to.have.all.keys(\"id\", \"titulo\", \"curso\", \"fechaEntrega\", \"estado\");",
                  "    pm.expect(tarea.id).to.be.a(\"number\");",
                  "    pm.expect(tarea.titulo).to.be.a(\"string\");",
                  "    pm.expect(tarea.curso).to.be.a(\"string\");",
                  "    pm.expect(tarea.fechaEntrega).to.match(/^\\d{4}-\\d{2}-\\d{2}T.*(?:Z|[+-]\\d{2}:\\d{2})$/);",
                  "    pm.expect(Number.isNaN(Date.parse(tarea.fechaEntrega))).to.eql(false);",
                  "    pm.expect([\"pendiente\", \"completada\"]).to.include(tarea.estado);",
                  "}",
                  "const tareas = pm.response.json();",
                  "pm.test(\"Arreglo de tareas con los cinco campos\", function () { pm.expect(tareas).to.be.an(\"array\"); tareas.forEach(validarTarea); });",
                  "pm.test(\"Hay datos de ejemplo\", function () { pm.expect(tareas.length).to.be.above(0); });",
                  "if (tareas.length) { const seleccionada = tareas.find(t => t.estado === \"pendiente\") || tareas[0]; pm.collectionVariables.set(\"tarea_id\", seleccionada.id); }"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "02 - Consultar una tarea",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/tareas/{{tarea_id}}/",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"La respuesta es JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "function validarTarea(tarea) {",
                  "    pm.expect(tarea).to.have.all.keys(\"id\", \"titulo\", \"curso\", \"fechaEntrega\", \"estado\");",
                  "    pm.expect(tarea.id).to.be.a(\"number\");",
                  "    pm.expect(tarea.titulo).to.be.a(\"string\");",
                  "    pm.expect(tarea.curso).to.be.a(\"string\");",
                  "    pm.expect(tarea.fechaEntrega).to.match(/^\\d{4}-\\d{2}-\\d{2}T.*(?:Z|[+-]\\d{2}:\\d{2})$/);",
                  "    pm.expect(Number.isNaN(Date.parse(tarea.fechaEntrega))).to.eql(false);",
                  "    pm.expect([\"pendiente\", \"completada\"]).to.include(tarea.estado);",
                  "}",
                  "pm.test(\"Detalle de la tarea seleccionada\", function () { validarTarea(pm.response.json()); pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"tarea_id\"))); });"
                ]
              }
            }
          ],
          "response": []
        },
